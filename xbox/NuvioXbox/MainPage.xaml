<Page
    x:Class="NuvioXbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
                <TextBlock Text="NUVIO" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="XBOX" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,4" Foreground="#D5DBE8" />
                <TextBlock Text="Cliente comunitário · pt-BR" FontSize="16" VerticalAlignment="Bottom" Margin="16,0,0,4" Foreground="#9AA7C1" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Content="Filmes" Click="Movies_Click" MinWidth="120" />
                <Button Content="Séries" Click="Series_Click" MinWidth="120" />
                <Button Content="Atualizar" Click="Refresh_Click" MinWidth="130" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="14" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Seus add-ons" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock Grid.Row="1" Text="Cole a URL do manifesto do add-on Stremio. O app não instala código executável de terceiros." TextWrapping="Wrap" Foreground="#AAB5CA" FontSize="14" Margin="0,0,0,12" />
                    <TextBox x:Name="ManifestUrlBox" Grid.Row="2" PlaceholderText="https://exemplo.org/manifest.json" MinHeight="52" FontSize="15" />
                    <ListView x:Name="AddonList" Grid.Row="3" Margin="0,12,0,12" SelectionMode="Single" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,10"><StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ManifestUrl}" FontSize="11" Foreground="#AAB5CA" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel></Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="4" Spacing="8">
                        <Button Content="Adicionar manifesto" Click="AddAddon_Click" MinHeight="52" HorizontalAlignment="Stretch" />
                        <Button Content="Remover selecionado" Click="RemoveAddon_Click" MinHeight="48" HorizontalAlignment="Stretch" />
                        <Button Content="Abrir diretório comunitário" Click="OpenAddonLibrary_Click" MinHeight="44" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SectionTitle" Text="Catálogos" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock x:Name="StatusText" Grid.Row="1" Text="Adicione um manifesto de catálogo ou provedor para começar." TextWrapping="Wrap" Foreground="#B7C2D7" FontSize="16" Margin="0,0,0,10" />
                <ListView x:Name="CatalogList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="Catalog_ItemClick" SelectionMode="None" Background="{StaticResource CardBackgroundBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10"><StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#AAB5CA" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SourceName}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                            </StackPanel></Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="3" Margin="0,14,0,8">
                    <TextBlock x:Name="SelectedTitle" Text="Selecione um título" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SelectedDescription" Text="Os streams compatíveis aparecerão abaixo." FontSize="14" Foreground="#AAB5CA" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="4" Text="Streams diretos" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,6" />
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="StreamList" Grid.Column="0" IsItemClickEnabled="True" ItemClick="Stream_ItemClick" Background="{StaticResource CardBackgroundBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8"><StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#AAB5CA" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel></Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <MediaPlayerElement x:Name="Player" Grid.Column="2" AreTransportControlsEnabled="True" AutoPlay="True" MinHeight="260" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" Text="Fontes configuradas pelo usuário. Use somente serviços e add-ons que você tem autorização para acessar. Legendas dependem do stream/add-on e ainda precisam de validação no Xbox." FontSize="12" Foreground="#8996AE" TextWrapping="Wrap" Margin="0,18,0,0" />
    </Grid>
</Page>
