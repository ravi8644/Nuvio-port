<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         IgnorableNamespaces="uap mp">
  <Identity Name="Ravi8644.NuvioXbox" Publisher="CN=NuvioXboxDev" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Nuvio para Xbox</DisplayName>
    <PublisherDisplayName>Nuvio Port Community</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <mp:PhoneIdentity PhoneProductId="4d421756-66a6-4d3c-9abd-8276168860ae" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>
  <Resources>
    <Resource Language="pt-BR" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="NuvioXbox.App">
      <uap:VisualElements DisplayName="Nuvio para Xbox" Description="Cliente comunitário para catálogos e streams configurados pelo usuário" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="#0B1020">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
